{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PagesAI Disk",
  "version": "0.1.0",
  "identifier": "cn.pagesai.disk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PagesAI Disk",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "PagesAI Disk sync client",
    "longDescription": "Sync one selected local folder with the deployer's own PagesAI Disk service.",
    "createUpdaterArtifacts": false,
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../../../../LICENSE": "licenses/PROJECT-LICENSE",
      "../../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../../docs/licenses/cargo": "licenses/cargo"
    }
  },
  "plugins": {}
}

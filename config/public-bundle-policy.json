{
  "schemaVersion": 1,
  "description": "公开导出版白名单（默认拒绝）。只有 include 命中的常规文件才会进入制品；deny 优先于 include，且覆盖内部审计、数据、日志、上传、用户邮件、密钥与私有路径。",
  "include": [
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-DECISION.md",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".gitignore",
    ".dockerignore",
    "core/**",
    "admin/**",
    "contracts/**",
    "deploy/**",
    "modules/**",
    "tests/**",
    "tools/**",
    "config/**",
    "docs/**",
    ".github/**"
  ],

# PagesAI 公开版环境变量示例（全部为占位值）
#
# 用途：声明公开版代码实际读取的全部环境变量，供部署时生成 secrets/pagesai.env。
# 用法：
#   1. 复制本文件为 secrets/pagesai.env（权限 0600，路径由 config.json 的 secrets.reference 指向）；
#   2. 按部署替换占位值；真实值只存在于该文件或部署平台，不进入 Git、不写入 config.json；
#   3. 本文件本身永远只放占位值，禁止提交任何真实域名、IP、账号、口令或令牌。
#
# 注意：本文件只是示例，不会被任何工具自动加载；config.json 才是部署事实来源，
#       环境变量用于服务进程的运行时配置，二者必须保持一致。

# ---------------------------------------------------------------- 公共核心
# core/config/index.js 读取；数据根在部署时用 tools/init.js --data-root 显式登记。
PAGESAI_INSTALL_ROOT=/srv/pagesai
PAGESAI_DATA_ROOT=/srv/pagesai-data
# 已安装业务模块，逗号分隔；空值表示仅公共核心。
PAGESAI_MODULES=pages,disk,glim,mail,survey,paper
# 是否允许公开注册（true/false）。
PAGESAI_REGISTRATION_ENABLED=true
# 是否启用邮箱验证码注册（true/false）；为 true 时必须安装 mail 模块。
PAGESAI_EMAIL_REGISTRATION=false
# 邮箱注册允许的域名白名单，逗号分隔；留空表示不限制。占位域名，勿填真实域名。
PAGESAI_EMAIL_DOMAINS=example.com
# 会话有效期（毫秒），不得小于 300000。
PAGESAI_SESSION_TTL_MS=604800000
# 首名管理员一次性引导令牌：必须是随机值（例如 openssl rand -hex 32），
# 只放在秘密材料文件中，禁止写入 config.json 或提交到仓库。
PAGESAI_BOOTSTRAP_TOKEN=replace-with-random-bootstrap-token

# ---------------------------------------------------------------- 运维工具
# tools/init.js、tools/upgrade.js、tools/uninstall.js 读取；命令行 --config 优先。
PAGESAI_CONFIG=/srv/pagesai/config.json
# tools/backup.js 与 tools/upgrade.js 的备份输出目录；生产建议指向独立卷。
PAGESAI_BACKUP_ROOT=/srv/pagesai-backups

# ---------------------------------------------------------------- 数据库
# 部署编排与后续数据库适配器使用；口令为占位值，真实值只放秘密材料文件。
PAGESAI_MONGO_USER=pagesai
PAGESAI_MONGO_PASSWORD=replace-with-random-mongo-password
PAGESAI_MONGO_HOST=mongo
PAGESAI_MONGO_DB=pagesai

# ---------------------------------------------------------------- 模块开发服务器（仅本地开发）
# modules/pages/server/dev.js 与 modules/survey/server/dev.js 的落盘路径；生产部署不需要。
PAGESAI_PAGES_DATA_FILE=/tmp/pagesai-dev/pages.json
PAGESAI_SURVEY_DATA_FILE=/tmp/pagesai-dev/survey.json
